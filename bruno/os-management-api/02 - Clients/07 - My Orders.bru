meta {
  name: My Orders
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/clients/my-orders
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{clientToken}}
}

docs {
  Client portal — lists the authenticated client's own service orders.
  Requires a CPF token (run "01 - Auth / 03 - Login via CPF (Serverless)" first).
  Swap {{baseUrl}} for {{gatewayUrl}} to exercise the protected route end to end.
}

