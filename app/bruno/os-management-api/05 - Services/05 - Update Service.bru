meta {
  name: Update Service
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/services/{{serviceId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "serviceType": "TROCA_OLEO",
    "idOS": "{{serviceOrderId}}"
  }
}

