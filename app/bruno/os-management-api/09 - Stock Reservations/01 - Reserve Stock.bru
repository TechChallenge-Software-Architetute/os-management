meta {
  name: Reserve Stock
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/stocks/reservations
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "serviceOrderId": "{{serviceOrderId}}",
    "items": [
      { "productId": 1, "quantity": 2.00 },
      { "productId": 2, "quantity": 3.50 }
    ]
  }
}

